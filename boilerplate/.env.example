# .env.example — plantilla de variables de entorno (Sirve versionar; sin secretos)
# Copia este archivo a .env y completa los valores reales. Nunca versiones .env.

APP_PORT=3000

# Persistencia (TypeORM)
#   - 'better-sqlite3' (default): sin setup, genera un archivo local.
#   - 'postgres': requiere DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
DB_TYPE=better-sqlite3
DB_DATABASE=boilerplate.sqlite

# Solo si DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boilerplate
DB_USER=root
DB_PASSWORD=secret