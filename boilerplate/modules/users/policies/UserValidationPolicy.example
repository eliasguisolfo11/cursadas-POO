# POLÍTICAS (STRATEGY) — una sola política activa por contexto. Sin if-chains.

# Interfaz de la estrategia (OCP: abierta a extensión, cerrada a modificación).
policy UserValidationPolicy:
  method validate(data: UserInput) -> ValidationResult

# Implementaciones intercambiables.
policy RegistrationValidationPolicy < UserValidationPolicy:
  method validate(data):
    # reglas estrictas de registro
    ...

policy BulkImportValidationPolicy < UserValidationPolicy:
  method validate(data):
    # reglas relajadas de importación masiva
    ...

# Uso: el caso de uso recibe la política POR INYECCIÓN (DIP), nunca un switch/if por tipo.
#   register(input, UserValidationPolicy)  -> inyecta la política correcta desde el
#   composition root. Así añadir una nueva política NO modifica el caso de uso.
