# Pseudocódigo de ejemplo (agnóstico a lenguaje).
# Este archivo es una PLANTILLA conceptual: al instanciar un proyecto, mapear a la
# sintaxis idiomática del lenguaje/framework elegido. La extensión .example sirve
# para recordar que no es código ejecutable, sino guía.

# ENTIDAD (agregado raíz) — SRP: solo encapsula su estado e invariantes.

entity User:
  id       : UserId          # value object
  email    : Email           # value object
  username : Username | nil
  status   : UserStatus

  method isActive() -> bool:
    return self.status == UserStatus.ACTIVE

# Las validaciones NO viven aquí como if-chains; se delegan a políticas (Strategy).
