# PUERTOS (DIP) — interfaces que el módulo define. La infraestructura las IMPLEMENTA.
# El dominio/use-cases dependen solo de estas abstracciones, nunca de la implementación.

port UserRepository:
  method save(user: User) -> void
  method findById(id: UserId) -> User | nil
  method findByEmail(email: Email) -> User | nil

port UserEventPublisher:
  method publish(event: DomainEvent) -> void
