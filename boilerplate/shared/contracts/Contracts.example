# CONTRATOS GLOBALES — interfaces/puertos usados por MÁS de un módulo (si se usa en varios).
# Si solo un módulo lo usa, mantener el puerto dentro de ese módulo (módulos/users/ports).

contract Logger:
  method info(msg) -> void
  method error(msg, error) -> void

contract Clock:
  method now() -> DateTime

contract IdGenerator:
  method generate() -> Id
